//**
// * @file tray.slint
// * @author doraemon-hub-art (1660219734@qq.com)
// * @brief System tray entry: the icon that keeps the process resident, and its menu
// * @date 2026-09-21
// *
// * @copyright Copyright (c) 2026
// */

// A tray-rooted component has no window of its own: the icon is the whole of its UI and
// the menu is the only way to reach it. While the icon is visible the event loop stays
// alive, which is what lets the panel be hidden without ending the process.
export component TrayIcon inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.png");
    tooltip: "more-effective-intrans";
    title: "more-effective-intrans";

    // The translation source the menu marks as the picked one. The mark has to sit in the label:
    // on Linux the tray backend hands the platform a label and an enabled flag and nothing else,
    // so a `checkable` entry would reach the menu without its checkmark.
    in-out property <string> source: "baidu";

    // The menu reports what was picked; what each entry means is decided in Rust.
    callback toggle-window();
    callback select-source(string);
    callback open-config();
    callback quit-app();

    // Exactly one Menu child is required, and it must not sit inside an if or a for.
    // GNOME draws no icon at all for an indicator without a menu, so in practice this
    // is not optional either.
    Menu {
        MenuItem {
            title: "显示 / 隐藏";
            activated => { root.toggle-window(); }
        }

        MenuSeparator { }

        // The translation source lives one level down: hovering over this entry is what
        // opens the list of sources, one MenuItem per source.
        Menu {
            title: "翻译源";

            MenuItem {
                title: root.source == "baidu" ? "✓ 百度" : "百度";
                activated => { root.select-source("baidu"); }
            }
        }

        MenuSeparator { }

        MenuItem {
            title: "打开配置文件";
            activated => { root.open-config(); }
        }

        MenuSeparator { }

        MenuItem {
            title: "退出";
            activated => { root.quit-app(); }
        }
    }
}
