# Rust build output
/target

# Backups written by rustfmt and some editors
**/*.rs.bk

# Editor and OS noise
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Note: Cargo.lock is intentionally tracked, it pins the exact
# dependency versions of this application crate.
